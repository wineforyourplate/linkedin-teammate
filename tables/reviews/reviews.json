{
  "name": "reviews",
  "primary_key_column": "id",
  "enable_rls": true,
  "visibility": "POD",
  "columns": [
    {
      "name": "week_of",
      "type": "TEXT",
      "max_length": 10
    },
    {
      "name": "summary",
      "type": "TEXT",
      "max_length": 2000
    },
    {
      "name": "numbers",
      "type": "JSON"
    },
    {
      "name": "best",
      "type": "JSON"
    },
    {
      "name": "plan",
      "type": "JSON"
    },
    {
      "name": "suggestion",
      "type": "TEXT",
      "max_length": 600
    },
    {
      "name": "status",
      "type": "ENUM",
      "options": [
        "new",
        "approved",
        "dismissed"
      ],
      "default": "new"
    },
    {
      "name": "kind",
      "type": "ENUM",
      "options": [
        "weekly",
        "daily"
      ],
      "default": "weekly"
    },
    {
      "name": "day",
      "type": "TEXT",
      "max_length": 10,
      "description": "Daily summaries: the day it covers, YYYY-MM-DD on their clock."
    },
    {
      "name": "body",
      "type": "TEXT",
      "max_length": 8000,
      "description": "Daily summaries: the summary itself, short markdown."
    }
  ]
}

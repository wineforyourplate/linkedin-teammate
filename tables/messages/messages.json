{
  "name": "messages",
  "primary_key_column": "id",
  "enable_rls": true,
  "visibility": "POD",
  "columns": [
    {
      "name": "person_id",
      "type": "UUID",
      "foreign_key": {
        "references": "people.id"
      }
    },
    {
      "name": "kind",
      "type": "ENUM",
      "options": [
        "first",
        "followup",
        "reply",
        "dm",
        "connect"
      ],
      "default": "first",
      "description": "first and followup: after a connection is accepted (follow-up skill). reply: answering their message. dm: a message to someone who showed interest in a thread. connect: the note on a connection request to someone who showed interest."
    },
    {
      "name": "body",
      "type": "TEXT",
      "max_length": 2000,
      "required": true
    },
    {
      "name": "status",
      "type": "ENUM",
      "options": [
        "draft",
        "approved",
        "sent",
        "skipped",
        "failed"
      ],
      "default": "draft"
    },
    {
      "name": "sent_at",
      "type": "DATETIME"
    },
    {
      "name": "error",
      "type": "TEXT",
      "max_length": 1000
    },
    {
      "name": "why",
      "type": "TEXT",
      "max_length": 400,
      "description": "One line the person reads before approving: what they said and why this message."
    }
  ],
  "config": {}
}

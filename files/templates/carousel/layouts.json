{
  "note": "Slide layouts and their slots. Word budgets are hard limits the renderer checks. Text slots accept **bold** and ==highlight==. List slots take '- item' lines. Image slots take a pod path to a file under /products/<slug>/assets/ or /templates/assets/.",
  "slide_max_words": 30,
  "layouts": {
    "cover":        { "purpose": "The hook. One claim the reader can repeat as news.", "slots": { "kicker": {"kind": "text", "max_words": 4}, "headline": {"kind": "text", "max_words": 12, "required": true}, "sub": {"kind": "text", "max_words": 12} } },
    "point":        { "purpose": "One idea per slide.", "slots": { "kicker": {"kind": "text", "max_words": 4}, "headline": {"kind": "text", "max_words": 12, "required": true}, "body": {"kind": "text", "max_words": 18} } },
    "stat":         { "purpose": "One real number with its denominator and source.", "slots": { "kicker": {"kind": "text", "max_words": 4}, "stat": {"kind": "number", "max_words": 1, "required": true}, "unit": {"kind": "text", "max_words": 2}, "label": {"kind": "text", "max_words": 12, "required": true}, "source": {"kind": "text", "max_words": 14} } },
    "screenshot":   { "purpose": "A real screen, in a phone or desktop frame.", "slots": { "kicker": {"kind": "text", "max_words": 4}, "headline": {"kind": "text", "max_words": 10, "required": true}, "image": {"kind": "image", "required": true}, "frame": {"kind": "choice", "options": ["desktop", "phone"], "default": "desktop"}, "caption": {"kind": "text", "max_words": 12} } },
    "thread":       { "purpose": "A real Slack or chat thread, as proof.", "slots": { "kicker": {"kind": "text", "max_words": 4}, "headline": {"kind": "text", "max_words": 10, "required": true}, "image": {"kind": "image", "required": true}, "caption": {"kind": "text", "max_words": 12} } },
    "before-after": { "purpose": "The old way against the new way.", "slots": { "kicker": {"kind": "text", "max_words": 4}, "headline": {"kind": "text", "max_words": 8, "required": true}, "before_label": {"kind": "text", "max_words": 2}, "before": {"kind": "text", "max_words": 14, "required": true}, "after_label": {"kind": "text", "max_words": 2}, "after": {"kind": "text", "max_words": 14, "required": true} } },
    "steps":        { "purpose": "How to put it together, 3-4 steps.", "slots": { "kicker": {"kind": "text", "max_words": 4}, "headline": {"kind": "text", "max_words": 8, "required": true}, "steps": {"kind": "list", "max_items": 4, "max_words": 8, "required": true} } },
    "system-map":   { "purpose": "Inputs, the teammate, outputs.", "slots": { "kicker": {"kind": "text", "max_words": 4}, "headline": {"kind": "text", "max_words": 8, "required": true}, "inputs": {"kind": "list", "max_items": 3, "max_words": 3, "required": true}, "core": {"kind": "text", "max_words": 3, "required": true}, "outputs": {"kind": "list", "max_items": 3, "max_words": 3, "required": true}, "caption": {"kind": "text", "max_words": 12} } },
    "quote":        { "purpose": "A real thing a real person said.", "slots": { "kicker": {"kind": "text", "max_words": 4}, "quote": {"kind": "text", "max_words": 20, "required": true}, "who": {"kind": "text", "max_words": 8, "required": true} } },
    "honest":       { "purpose": "The limit. What it doesn't do, or what a person still decides.", "slots": { "kicker": {"kind": "text", "max_words": 5}, "headline": {"kind": "text", "max_words": 10, "required": true}, "body": {"kind": "text", "max_words": 18} } },
    "cta":          { "purpose": "One action. The repo, the tour, or a comment keyword.", "slots": { "headline": {"kind": "text", "max_words": 10, "required": true}, "action": {"kind": "text", "max_words": 8, "required": true}, "detail": {"kind": "text", "max_words": 12} } },
    "close":        { "purpose": "The takeaway and one real question.", "slots": { "headline": {"kind": "text", "max_words": 10, "required": true}, "question": {"kind": "text", "max_words": 14} } }
  }
}

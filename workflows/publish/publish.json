{
  "name": "publish",
  "description": "Wait for an approved post's slot, then claim it and publish it: through the LinkedIn API for text, image and link posts (then read back), in the browser only for what the API can't post or when the person opted in, otherwise held until they reconnect. Only a write that approved the draft starts a publish, one run owns it, and the text is checked before and after.",
  "start": {
    "type": "DATASTORE_EVENT",
    "config": {
      "table_name": "drafts",
      "operations": [
        "INSERT",
        "UPDATE"
      ]
    }
  },
  "nodes": [
    {
      "id": "clock",
      "type": "FUNCTION",
      "label": "Check the slot",
      "config": {
        "function_name": "post_clock",
        "input_mapping": {
          "draft_id": {
            "type": "expression",
            "value": "start.metadata.record_id"
          },
          "approved_at": {
            "type": "expression",
            "value": "start.payload.approved_at",
            "optional": true
          },
          "approved_body": {
            "type": "expression",
            "value": "start.payload.body",
            "optional": true
          },
          "trigger_operation": {
            "type": "expression",
            "value": "start.metadata.operation",
            "optional": true
          },
          "trigger_changed": {
            "type": "expression",
            "value": "start.metadata.changed",
            "optional": true
          },
          "run_key": {
            "type": "expression",
            "value": "start.metadata.fired_at",
            "optional": true
          }
        }
      }
    },
    {
      "id": "route",
      "type": "DECISION",
      "label": "Publish, wait or stop?",
      "config": {
        "rules": [
          {
            "condition": "(recheck.action || clock.action) == 'publish' && (recheck.tell || clock.tell) == `true`",
            "next_node_id": "tell_go"
          },
          {
            "condition": "(recheck.action || clock.action) == 'publish'",
            "next_node_id": "how"
          },
          {
            "condition": "(recheck.action || clock.action) == 'wait_short'",
            "next_node_id": "wait_short"
          },
          {
            "condition": "(recheck.action || clock.action) == 'wait_long'",
            "next_node_id": "wait_long"
          },
          {
            "condition": "(recheck.action || clock.action) == 'stop' && (recheck.tell || clock.tell) == `true`",
            "next_node_id": "tell_stop"
          }
        ]
      }
    },
    {
      "id": "wait_long",
      "type": "WAIT_UNTIL",
      "label": "An hour",
      "config": {
        "timeout_seconds": 3600
      }
    },
    {
      "id": "wait_short",
      "type": "WAIT_UNTIL",
      "label": "Five minutes",
      "config": {
        "timeout_seconds": 300
      }
    },
    {
      "id": "recheck",
      "type": "FUNCTION",
      "label": "Check the slot again",
      "config": {
        "function_name": "post_clock",
        "input_mapping": {
          "draft_id": {
            "type": "expression",
            "value": "start.metadata.record_id"
          },
          "approved_at": {
            "type": "expression",
            "value": "start.payload.approved_at",
            "optional": true
          },
          "approved_body": {
            "type": "expression",
            "value": "start.payload.body",
            "optional": true
          },
          "trigger_operation": {
            "type": "expression",
            "value": "start.metadata.operation",
            "optional": true
          },
          "trigger_changed": {
            "type": "expression",
            "value": "start.metadata.changed",
            "optional": true
          },
          "run_key": {
            "type": "expression",
            "value": "start.metadata.fired_at",
            "optional": true
          }
        }
      }
    },
    {
      "id": "how",
      "type": "DECISION",
      "label": "API or browser?",
      "config": {
        "rules": [
          {
            "condition": "(recheck.route || clock.route) == 'api'",
            "next_node_id": "api"
          },
          {
            "condition": "(recheck.route || clock.route) == 'browser'",
            "next_node_id": "browser"
          }
        ]
      }
    },
    {
      "id": "api",
      "type": "FUNCTION",
      "label": "Publish through the LinkedIn API",
      "config": {
        "function_name": "publish_api",
        "input_mapping": {
          "draft_id": {
            "type": "expression",
            "value": "start.metadata.record_id"
          }
        }
      }
    },
    {
      "id": "api_ok",
      "type": "DECISION",
      "label": "Posted, or browser by choice?",
      "config": {
        "rules": [
          {
            "condition": "api.ok == `true`",
            "next_node_id": "verify"
          },
          {
            "condition": "api.use_browser == `true`",
            "next_node_id": "browser"
          },
          {
            "condition": "api.tell == `true`",
            "next_node_id": "tell_stop"
          }
        ]
      }
    },
    {
      "id": "browser",
      "type": "AGENT",
      "label": "Publish in the browser",
      "config": {
        "agent_name": "teammate",
        "input_mapping": {
          "task": {
            "type": "literal",
            "value": "publish"
          },
          "draft_id": {
            "type": "expression",
            "value": "start.metadata.record_id"
          }
        }
      }
    },
    {
      "id": "verify",
      "type": "AGENT",
      "label": "Read the post back",
      "config": {
        "agent_name": "teammate",
        "input_mapping": {
          "task": {
            "type": "literal",
            "value": "verify-post"
          },
          "draft_id": {
            "type": "expression",
            "value": "start.metadata.record_id"
          }
        }
      }
    },
    {
      "id": "tell_go",
      "type": "AGENT",
      "label": "Tell them, then go on",
      "config": {
        "agent_name": "teammate",
        "input_mapping": {
          "task": {
            "type": "literal",
            "value": "publish-tell"
          },
          "draft_id": {
            "type": "expression",
            "value": "start.metadata.record_id"
          }
        }
      }
    },
    {
      "id": "tell_stop",
      "type": "AGENT",
      "label": "Tell them it was held",
      "config": {
        "agent_name": "teammate",
        "input_mapping": {
          "task": {
            "type": "literal",
            "value": "publish-tell"
          },
          "draft_id": {
            "type": "expression",
            "value": "start.metadata.record_id"
          }
        }
      }
    },
    {
      "id": "published",
      "type": "END",
      "label": "Published",
      "config": {}
    },
    {
      "id": "stopped",
      "type": "END",
      "label": "Stopped, held or refused",
      "config": {}
    }
  ],
  "edges": [
    {
      "id": "e0",
      "source": "clock",
      "target": "route"
    },
    {
      "id": "e2",
      "source": "wait_long",
      "target": "recheck"
    },
    {
      "id": "e3",
      "source": "wait_short",
      "target": "recheck"
    },
    {
      "id": "e4",
      "source": "recheck",
      "target": "route"
    },
    {
      "id": "e6",
      "source": "api",
      "target": "api_ok"
    },
    {
      "id": "e8",
      "source": "browser",
      "target": "published"
    },
    {
      "id": "e15",
      "source": "verify",
      "target": "published"
    },
    {
      "id": "e18",
      "source": "how",
      "target": "stopped"
    },
    {
      "id": "e5",
      "source": "how",
      "target": "browser"
    },
    {
      "id": "e12",
      "source": "how",
      "target": "api"
    },
    {
      "id": "e1",
      "source": "route",
      "target": "stopped"
    },
    {
      "id": "e9",
      "source": "route",
      "target": "how"
    },
    {
      "id": "e10",
      "source": "route",
      "target": "wait_short"
    },
    {
      "id": "e11",
      "source": "route",
      "target": "wait_long"
    },
    {
      "id": "e20",
      "source": "route",
      "target": "tell_go"
    },
    {
      "id": "e21",
      "source": "route",
      "target": "tell_stop"
    },
    {
      "id": "e19",
      "source": "api_ok",
      "target": "stopped"
    },
    {
      "id": "e7",
      "source": "api_ok",
      "target": "browser"
    },
    {
      "id": "e14",
      "source": "api_ok",
      "target": "verify"
    },
    {
      "id": "e22",
      "source": "api_ok",
      "target": "tell_stop"
    },
    {
      "id": "e23",
      "source": "tell_go",
      "target": "how"
    },
    {
      "id": "e24",
      "source": "tell_stop",
      "target": "stopped"
    }
  ]
}

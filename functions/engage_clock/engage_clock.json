      {"resource_type": "datastore_table", "resource_name": "skills", "permission_ids": ["datastore.table.read", "datastore.record.read", "datastore.record.write"]},
      {"resource_type": "datastore_table", "resource_name": "engagements", "permission_ids": ["datastore.table.read", "datastore.record.read", "datastore.record.write"]}
    ]
  }

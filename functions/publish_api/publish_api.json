{
  "name": "publish_api",
  "description": "Publish a claimed text, image or link post through LinkedIn's official API, after the same text checks as publish_guard. When the API fails the post is held and the person told once; the browser is used instead only if they opted in. Never writes the draft back to approved.",
  "type": "API",
  "visibility": "POD",
  "code": {
    "$file": "code.py"
  },
  "permissions": {
    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "drafts",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "profile",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "activity",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "connector",
        "resource_name": "linkedin",
        "permission_ids": [
          "connector.use"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "skills",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      }
    ]
  }
}
